# このファイルを .env にコピーして、LINE Developersの値を貼る
# (.env は絶対にGitHubに上げない → .gitignore済み)

# --- LIFFアプリ (LINEログインチャネル > LIFFタブ) ---
LIFF_ID=

# --- LINEログインチャネルの「チャネルID」(IDトークン検証用) ---
LINE_LOGIN_CHANNEL_ID=

# --- Messaging APIチャネルの「チャネルアクセストークン」(Push通知用) ---
LINE_CHANNEL_ACCESS_TOKEN=

# --- Messaging APIチャネルの「チャネルシークレット」(Webhook署名検証用) ---
LINE_CHANNEL_SECRET=

# --- ローカル開発時だけ 1 にする (LINEなしでブラウザから試せる) ---
DEV_MODE=1
